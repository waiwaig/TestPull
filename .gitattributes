# Auto-detect text files and normalize line endings
* text=auto

# Source files
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp
*.c text diff=cpp
*.cs diff=csharp

# Visual Studio files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf

# Scripts
*.bat text eol=crlf
*.ps1 text eol=crlf
*.py text diff=python

# Documentation
*.md text diff=markdown
*.txt text

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.bmp binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary
*.obj binary
